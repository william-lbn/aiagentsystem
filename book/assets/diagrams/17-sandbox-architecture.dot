digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.18",nodesep="0.34",ranksep="0.48"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=14,color="#34495e"];
edge [fontname="Noto Sans CJK SC",fontsize=10,color="#5d6d7e"];
agent [label="Untrusted Agent / Dependency",fillcolor="#fff4e6"];
gate [label="Tool Capability Gate\nPath · Command · Payload",fillcolor="#fdecea"];
process [label="Process Boundary\nUID · Env · Secret Broker",fillcolor="#edf5ff"];
os [label="OS / Container / VM\nNamespace · Seccomp · LSM",fillcolor="#f6efff"];
resources [label="Resource + Network Policy\nCPU · Memory · PIDs · Egress",fillcolor="#fdecea"];
workspace [label="Scoped Workspace\nRO Inputs · RW Outputs",fillcolor="#eef9f1"];
audit [label="Redacted Audit + Artifact Digest",fillcolor="#edf5ff"];
agent->gate;
gate->process;
process->os;
os->resources;
resources->workspace;
workspace->audit;
}
