digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.18",nodesep="0.34",ranksep="0.48"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=15,color="#34495e",penwidth=1.2];
edge [fontname="Noto Sans CJK SC",fontsize=10,color="#5d6d7e"];
user [label="User / Enterprise Policy",fillcolor="#fff4e6"];
host [label="MCP Host\nModel · Trust · Approval · Context",fillcolor="#fdecea"];
client [label="MCP Client\nPer-Request Version/Capabilities",fillcolor="#edf5ff"];
server [label="MCP Server\nTools · Resources · Prompts",fillcolor="#eef9f1"];
backend [label="Backend / Explicit State Handle\nTasks / Business Systems",fillcolor="#fff4e6"];
evidence [label="Wire + Trace + Effect Evidence",fillcolor="#f6efff"];
user->host;
