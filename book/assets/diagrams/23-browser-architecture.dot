digraph G {
graph [rankdir=LR,bgcolor="transparent",pad="0.18",nodesep="0.30",ranksep="0.55"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=12,color="#34495e"];
edge [fontname="Noto Sans CJK SC",fontsize=9,color="#5d6d7e"];
env [label="Web / Desktop Environment\nState + Revision",fillcolor="#eef9f1"];
obs [label="Observation Builder\nDOM · AX Tree · Screenshot · Digest",fillcolor="#edf5ff"];
model [label="Model / Policy\nCandidate Action",fillcolor="#fff4e6"];
gate [label="Action Gate\nTarget · Revision · Approval",fillcolor="#fdecea"];
executor [label="Browser / Computer Executor\nClick · Type · Navigate",fillcolor="#f6efff"];
receipt [label="Receipt + New Observation",fillcolor="#edf5ff"];
verify [label="Postcondition Verifier\nBusiness State / DOM Invariant",fillcolor="#eef9f1"];
env->obs;
obs->model;
model->gate;
gate->executor;
executor->env;
executor->receipt;
receipt->verify;
env->verify [label="authoritative state",constraint=false];
}
