digraph G {
graph [rankdir=LR,bgcolor="transparent",pad="0.15",nodesep="0.35",ranksep="0.52"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=15,color="#34495e",penwidth=1.2];
edge [fontname="Noto Sans CJK SC",fontsize=10,color="#5d6d7e"];
client [label="A2A Client\n发现 + 版本选择",fillcolor="#fff4e6"];
card [label="Agent Card\n能力声明（不可信）",fillcolor="#edf5ff"];
auth [label="Delegation Gate\nprincipal/task/scope/expiry",fillcolor="#fdecea"];
store [label="Durable Task Store\nstate/version/event",fillcolor="#eef9f1"];
worker [label="Remote Executor\n受限能力",fillcolor="#edf5ff"];
artifact [label="Artifact Store\nschema + digest",fillcolor="#f6efff"];
verify [label="Local Verifier\n业务完成性",fillcolor="#f7f9f9"];
client->card [label="discover"];
card->auth [label="select interface"];
auth->store [label="authorized submit"];
store->worker [label="claim / resume"];
worker->artifact [label="deliver"];
artifact->verify [label="evidence"];
verify->store [label="terminal decision",style=dashed];
auth->verify [label="reject before effect",color="#b03a2e",style=dashed];
}
