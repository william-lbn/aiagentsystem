digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.15",nodesep="0.27",ranksep="0.40"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=15,color="#34495e",fillcolor="#f8fbfd"];
edge [fontname="Noto Sans CJK SC",fontsize=10,color="#5d6d7e"];
ingest [label="接收 audio / vision event"];
intent [label="生成并授权 effect intent"];
start [label="记录 started_epoch + key"];
interrupt [shape=diamond,label="用户修订 / 打断?",fillcolor="#fff4e6"];
advance [label="active_epoch += 1\n传播 cancellation",fillcolor="#fdecea"];
complete [label="接收异步 completion"];
current [shape=diamond,label="started_epoch ==\nactive_epoch?",fillcolor="#fff4e6"];
commit [label="COMMITTED + receipt",fillcolor="#eaf7ee"];
drop [label="STALE_DROPPED\n零 effect",fillcolor="#fdecea"];
unknown [label="若底层可能已提交\n转 UNKNOWN / reconcile",fillcolor="#f6efff"];
ingest->intent;
intent->start;
start->interrupt;
interrupt->complete [label="no"];
interrupt->advance [label="yes",color="#b03a2e"];
advance->complete;
complete->current;
current->commit [label="yes"];
current->drop [label="no / 未提交",color="#b03a2e"];
current->unknown [label="no / 可能提交",style=dashed];
}
