digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.18",nodesep="0.3",ranksep="0.42"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=15,color="#34495e"];
edge [fontname="Noto Sans CJK SC",fontsize=10,color="#5d6d7e"];
resolve [label="Resolve Exact Version + Digest",fillcolor="#fff4e6"];
validate [label="Schema / Source / Dependency"];
caps [shape=diamond,label="Declared Capabilities\n在 Policy 内?",fillcolor="#fdecea"];
dag [label="构建 DAG\n检查 Missing/Cycle",fillcolor="#edf5ff"];
activate [label="创建 Activation ID\n绑定 Manifest Hash",fillcolor="#eef9f1"];
execute [label="逐 Step 执行与持久化"];
reject [label="拒绝 · Steps Executed = 0",fillcolor="#fdecea"];
resolve->validate;
validate->caps;
caps->dag [label="是"];
caps->reject [label="否",color="#b03a2e"];
dag->activate;
activate->execute;
}
