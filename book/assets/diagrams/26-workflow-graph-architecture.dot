digraph G {
graph [rankdir=LR,bgcolor="transparent",pad="0.18",nodesep="0.30",ranksep="0.55"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=12,color="#34495e"];
edge [fontname="Noto Sans CJK SC",fontsize=9,color="#5d6d7e"];
definition [label="Graph Definition\nNode · Edge · Schema · Signature",fillcolor="#edf5ff"];
runtime [label="Graph Runtime\nReducer · Router · Interrupt",fillcolor="#fff4e6"];
checkpoint [label="Checkpoint Store\nState · Version · Topology",fillcolor="#f6efff"];
effect [label="Effect Protocol\nIntent · Key · Receipt · Reconcile",fillcolor="#fdecea"];
external [label="External Systems",fillcolor="#eef9f1"];
resume [label="Resume Input / Approval",fillcolor="#edf5ff"];
verify [label="Terminal Verifier",fillcolor="#eef9f1"];
definition->runtime;
runtime->checkpoint [label="CAS commit"];
runtime->effect;
effect->external;
external->effect [label="observation"];
effect->checkpoint [label="evidence",constraint=false];
resume->runtime;
runtime->verify;
}
