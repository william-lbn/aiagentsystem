digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.18",nodesep="0.3",ranksep="0.4"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=14,color="#34495e"];
edge [fontname="Noto Sans CJK SC",fontsize=10,color="#5d6d7e"];
inspect [label="读取当前文件与测试\n绑定 Base / Preimage",fillcolor="#edf5ff"];
proposal [label="生成最小 Patch",fillcolor="#fff4e6"];
scope [shape=diamond,label="Scope 与 Preimage 有效?",fillcolor="#fdecea"];
apply [label="应用 Patch\n生成 Unified Diff + Digest",fillcolor="#eef9f1"];
test [label="独立子进程执行 Verifier",fillcolor="#f6efff"];
pass [shape=diamond,label="退出码 0 且后置条件满足?",fillcolor="#fdecea"];
accept [label="接受 Artifact",fillcolor="#eef9f1"];
rollback [label="回滚原文件\n保存失败证据",fillcolor="#fdecea"];
reject [label="拒绝越界 / 漂移",fillcolor="#fdecea"];
inspect->proposal;
proposal->scope;
scope->apply [label="是"];
scope->reject [label="否"];
apply->test;
test->pass;
pass->accept [label="是"];
pass->rollback [label="否 / 超时"];
rollback->inspect [label="下一轮",style=dashed];
}
