digraph G {
graph [rankdir=LR,bgcolor="transparent",pad="0.15",nodesep="0.32",ranksep="0.52"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=14,color="#34495e",penwidth=1.2,fillcolor="#f8fbfd"];
edge [fontname="Noto Sans CJK SC",fontsize=9,color="#5d6d7e"];
input [label="User / data\ntrust + tenant",fillcolor="#fff4e6"];
identity [label="Identity / capability\nreference monitor"];
model [label="Model / planner\nproposal only",fillcolor="#edf5ff"];
runtime [label="Durable runtime\nstate + lease + budget"];
approval [label="Intent-bound\napproval",fillcolor="#f6efff"];
effect [label="Effect coordinator\nkey + UNKNOWN"];
provider [label="Tool / browser / code\nremote provider"];
evidence [label="Trace / artifact\nreceipt + provenance"];
verifier [label="Independent verifier\npromotion gate",fillcolor="#eaf7ee"];
input->identity;
identity->model;
model->runtime;
runtime->approval;
approval->effect;
effect->provider;
provider->evidence;
evidence->verifier;
runtime->evidence [style=dashed];
verifier->runtime [label="complete / quarantine",style=dashed];
}
