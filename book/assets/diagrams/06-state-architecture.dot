digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.18",nodesep="0.32",ranksep="0.42"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=14,color="#34495e",penwidth=1.2];
edge [fontname="Noto Sans CJK SC",fontsize=10,color="#5d6d7e"];
events [label="Ordered State Events\nsequence · from · to · reason",fillcolor="#fff4e6"];
reducer [label="Versioned Reducer\n合法转移 + 终态单调",fillcolor="#edf5ff"];
state [label="Derived Run State\nphase · pending · digest",fillcolor="#eef9f1"];
checkpoint [label="Checkpoint Store\nversion + atomic write + CAS",fillcolor="#f6efff"];
workers [label="Worker A / Worker B\nlease + expected_version",fillcolor="#edf5ff"];
journal [label="Effect Journal\nIntent · Receipt · UNKNOWN",fillcolor="#fdecea"];
events->reducer;
reducer->state;
state->checkpoint [label="snapshot"];
workers->checkpoint [label="load / compare-and-swap"];
state->journal [label="effect boundary"];
journal->events [label="observation",style=dashed];
}
