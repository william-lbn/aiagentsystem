digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.18",nodesep="0.28",ranksep="0.40"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=13,color="#34495e"];
edge [fontname="Noto Sans CJK SC",fontsize=9,color="#5d6d7e"];
compile [label="编译 Graph\n计算 Topology / Schema Signature",fillcolor="#edf5ff"];
load [label="加载 Run State + Version",fillcolor="#f6efff"];
match [shape=diamond,label="Persisted Signature 匹配?",fillcolor="#fdecea"];
execute [label="执行 Node\nState Delta / Effect Intent",fillcolor="#fff4e6"];
cas [shape=diamond,label="Checkpoint CAS 成功?",fillcolor="#fdecea"];
effect [label="Effect Key 执行 / Reconcile",fillcolor="#eef9f1"];
terminal [shape=diamond,label="Terminal + Verified?",fillcolor="#fdecea"];
finish [label="FINISHED + Evidence",fillcolor="#eef9f1"];
reject [label="拒绝恢复 / 冲突重读",fillcolor="#fdecea"];
compile->load;
load->match;
match->execute [label="是"];
match->reject [label="否"];
execute->cas;
cas->effect [label="是"];
cas->reject [label="否"];
effect->terminal;
terminal->finish [label="是"];
terminal->load [label="否",style=dashed];
}
