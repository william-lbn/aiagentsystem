digraph G {
graph [rankdir=LR,bgcolor="transparent",pad="0.18",nodesep="0.30",ranksep="0.55"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=13,color="#34495e",penwidth=1.2];
edge [fontname="Noto Sans CJK SC",fontsize=9,color="#5d6d7e"];
goal [label="Goal + Repo Baseline",fillcolor="#fff4e6"];
session [label="Session Ledger\nAncestry · Typed Facts · Snapshot",fillcolor="#edf5ff"];
context [label="Context Projection\nBudgeted · Source Pointers",fillcolor="#f6efff"];
model [label="Model Adapter\nPatch / Tool Proposal",fillcolor="#fff4e6"];
runtime [label="Harness Runtime\nSchema · Policy · Approval",fillcolor="#fdecea"];
workspace [label="Isolated Workspace\nWorktree / Container",fillcolor="#eef9f1"];
verifier [label="Independent Verifier\nTests · Diff · Artifact",fillcolor="#f6efff"];
goal->session [label="create / branch"];
session->context [label="compact"];
context->model;
model->runtime [label="untrusted proposal"];
runtime->workspace [label="authorized action"];
workspace->verifier [label="observation"];
verifier->session [label="fact + digest",constraint=false];
}
