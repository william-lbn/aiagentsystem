digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.18",nodesep="0.34",ranksep="0.48"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=15,color="#34495e",penwidth=1.2];
edge [fontname="Noto Sans CJK SC",fontsize=10,color="#5d6d7e"];
plan [label="Retrieval Policy\nRoute · Budget · Stop",fillcolor="#fff4e6"];
sparse [label="Lexical / BM25",fillcolor="#edf5ff"];
second [label="Dense 或第二检索器",fillcolor="#edf5ff"];
structured [label="SQL / Graph",fillcolor="#edf5ff"];
gate [label="Adapter Contract Gate\nAuthorized ID Universe",fillcolor="#fdecea"];
fusion [label="RRF + Provenance",fillcolor="#eef9f1"];
evidence [label="Evidence Coverage\nConflict · Authority · Freshness",fillcolor="#f6efff"];
plan->sparse;
plan->second;
plan->structured;
sparse->gate;
second->gate;
structured->gate;
gate->fusion;
fusion->evidence;
evidence->plan [label="insufficient: rewrite/decompose",style=dashed,color="#7d3c98"];
}
