digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.18",nodesep="0.3",ranksep="0.42"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=14,color="#34495e",penwidth=1.2];
edge [fontname="Noto Sans CJK SC",fontsize=10,color="#5d6d7e"];
goal [label="Goal + Belief/World State",fillcolor="#fff4e6"];
planner [label="Planner\n模型/搜索/规则",fillcolor="#edf5ff"];
proposal [label="Typed Plan Proposal\nSteps · Dependencies · Effects",fillcolor="#edf5ff"];
gate [label="Feasibility Gate\nDAG · Capability · Budget\nPrecondition · Authorization",fillcolor="#fdecea"];
scheduler [label="Scheduler\n资源 · 并发 · 时间",fillcolor="#eef9f1"];
executor [label="Executor\nIntent · Tool · Receipt",fillcolor="#eef9f1"];
verify [label="Observer + Verifier",fillcolor="#f6efff"];
goal->planner;
planner->proposal;
proposal->gate;
gate->scheduler [label="feasible"];
scheduler->executor;
executor->verify;
verify->planner [label="replan / stop",style=dashed,color="#7d3c98"];
}
