digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.18",nodesep="0.28",ranksep="0.40"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=13,color="#34495e"];
edge [fontname="Noto Sans CJK SC",fontsize=9,color="#5d6d7e"];
root [label="创建 Root Session\n锁定 Baseline / Workspace",fillcolor="#edf5ff"];
parent [shape=diamond,label="Parent 存在且可分支?",fillcolor="#fdecea"];
branch [label="创建独立 Branch / Workspace",fillcolor="#eef9f1"];
facts [label="写入 Constraint / Failure / Decision",fillcolor="#edf5ff"];
compact [label="按 Ancestry 压缩 Typed Facts\n生成 Snapshot Digest",fillcolor="#f6efff"];
reopen [label="关闭并重开 Durable Store",fillcolor="#edf5ff"];
verify [shape=diamond,label="Ancestry 与关键事实一致?",fillcolor="#fdecea"];
resume [label="恢复执行",fillcolor="#eef9f1"];
reject [label="拒绝 Orphan\n零行写入",fillcolor="#fdecea"];
root->parent;
parent->branch [label="是"];
parent->reject [label="否"];
branch->facts;
facts->compact;
compact->reopen;
reopen->verify;
verify->resume [label="是"];
verify->reject [label="否"];
}
