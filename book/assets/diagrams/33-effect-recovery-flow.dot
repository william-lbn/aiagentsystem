digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.15",nodesep="0.28",ranksep="0.42"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=16,color="#34495e",fillcolor="#f8fbfd"];
edge [fontname="Noto Sans CJK SC",fontsize=11,color="#5d6d7e"];
prepare [label="持久化 PREPARED\nkey + operation + args digest"];
apply [label="Provider apply\ninsert-or-return-existing"];
ack [shape=diamond,label="收到 durable receipt?",fillcolor="#fff4e6"];
commit [label="本地 COMMITTED + receipt",fillcolor="#eef9f1"];
unknown [label="持久化 UNKNOWN\n禁止盲重试",fillcolor="#fdecea"];
lookup [label="重启后按 key 查询 Provider"];
observed [shape=diamond,label="观察到 effect?",fillcolor="#fff4e6"];
notapplied [label="NOT_COMMITTED\n策略允许后重试"];
prepare->apply;
apply->ack;
ack->commit [label="yes"];
ack->unknown [label="no",color="#b03a2e"];
unknown->lookup;
lookup->observed;
observed->commit [label="receipt"];
observed->notapplied [label="authoritative absent"];
}
