digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.18",nodesep="0.3",ranksep="0.4"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=14,color="#34495e"];
edge [fontname="Noto Sans CJK SC",fontsize=10,color="#5d6d7e"];
load [label="Load Snapshot + Version\n验证 Schema / Hash Chain",fillcolor="#edf5ff"];
intent [label="Journal: Effect INTENT",fillcolor="#f6efff"];
dispatch [label="Dispatch External Action",fillcolor="#fff4e6"];
known [shape=diamond,label="获得权威 Receipt?",fillcolor="#fdecea"];
record [label="Journal: OBSERVED\nCAS 保存新 Checkpoint",fillcolor="#eef9f1"];
unknown [label="UNKNOWN\nQuery / Reconcile",fillcolor="#fdecea"];
conflict [shape=diamond,label="Expected Version 仍当前?",fillcolor="#fdecea"];
retry [label="Conflict → Reload / Replan",fillcolor="#fdecea"];
load->intent;
intent->dispatch;
dispatch->known;
known->record [label="是"];
known->unknown [label="否"];
unknown->known [label="权威查询",style=dashed];
record->conflict;
conflict->retry [label="否"];
conflict->load [label="下一步",style=dashed];
}
