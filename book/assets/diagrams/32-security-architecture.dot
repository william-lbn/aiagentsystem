digraph G {
graph [rankdir=LR,bgcolor="transparent",pad="0.15",nodesep="0.4",ranksep="0.55"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=17,color="#34495e",penwidth=1.2];
edge [fontname="Noto Sans CJK SC",fontsize=11,color="#5d6d7e"];
trusted [label="Authenticated instruction\nprincipal + policy",fillcolor="#fff4e6"];
untrusted [label="Untrusted data\nweb · tool · memory · agent",fillcolor="#fdecea"];
model [label="Model\nproposes ToolIntent",fillcolor="#edf5ff"];
gateway [label="Capability gateway\nidentity · resource · args",fillcolor="#eef9f1"];
sandbox [label="Sandbox + credential broker\nleast privilege · egress",fillcolor="#f6efff"];
audit [label="Effect receipt + redacted audit",fillcolor="#f7f9f9"];
trusted->model;
untrusted->model [label="data only"];
model->gateway [label="candidate intent"];
gateway->sandbox [label="allow"];
gateway->audit [label="deny"];
sandbox->audit;
}
