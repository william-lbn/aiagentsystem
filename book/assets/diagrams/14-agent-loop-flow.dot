digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.18",nodesep="0.3",ranksep="0.4"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=14,color="#34495e"];
edge [fontname="Noto Sans CJK SC",fontsize=10,color="#5d6d7e"];
start [label="READY\n建立 Run 与有限预算",fillcolor="#edf5ff"];
decide [label="模型提出结构化 Decision",fillcolor="#fff4e6"];
kind [shape=diamond,label="Decision Kind?",fillcolor="#fdecea"];
gate [label="Schema · Policy · Approval",fillcolor="#fdecea"];
act [label="执行 Tool 并记录 Observation",fillcolor="#eef9f1"];
progress [shape=diamond,label="有新证据且预算充足?",fillcolor="#fdecea"];
verify [label="独立 Verifier",fillcolor="#f6efff"];
finished [label="FINISHED",fillcolor="#eef9f1"];
stop [label="NEEDS_INPUT / FAILED / UNKNOWN\nBUDGET_EXCEEDED / NO_PROGRESS",fillcolor="#fdecea"];
start->decide;
decide->kind;
kind->gate [label="act"];
kind->verify [label="finish"];
kind->stop [label="input / fail"];
gate->act;
act->progress;
progress->decide [label="是"];
progress->stop [label="否"];
verify->finished [label="PASS"];
verify->stop [label="FAIL"];
}
