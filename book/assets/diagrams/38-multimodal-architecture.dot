digraph G {
graph [rankdir=LR,bgcolor="transparent",pad="0.15",nodesep="0.34",ranksep="0.52"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=15,color="#34495e",penwidth=1.2,fillcolor="#f8fbfd"];
edge [fontname="Noto Sans CJK SC",fontsize=10,color="#5d6d7e"];
media [label="Audio / video / sensor\nmedia plane",fillcolor="#fff4e6"];
events [label="Event plane\ntime / seq / trust / digest",fillcolor="#edf5ff"];
fusion [label="Context fusion\npartial / final / watermark"];
model [label="Model decision\nstructured intent"];
gate [label="Capability + epoch\ndeadline gate",fillcolor="#f6efff"];
effect [label="Tool / browser / actuator"];
observe [label="Receipt / sensor\nindependent observation",fillcolor="#eaf7ee"];
safety [label="E-stop / safety controller",fillcolor="#fdecea"];
media->events;
events->fusion;
fusion->model;
model->gate;
gate->effect;
effect->observe;
safety->gate [label="fence",color="#b03a2e"];
safety->effect [label="hard stop",color="#b03a2e"];
observe->events [label="feedback",style=dashed];
}
