digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.18",nodesep="0.28",ranksep="0.38"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=14,color="#34495e",fillcolor="#f8fbfd"];
edge [fontname="Noto Sans CJK SC",fontsize=10,color="#5d6d7e"];
received [label="RECEIVED\n建立 run_id"];
proposed [label="PROPOSED\n规范化参数 + action_id"];
waiting [label="WAITING_APPROVAL\n先持久化 intent",fillcolor="#fff4e6"];
check [shape=diamond,label="审批是否绑定\nrun + action + args?",fillcolor="#fdecea"];
execute [label="EXECUTING\n调用真实工具",fillcolor="#eef9f1"];
receipt [label="OBSERVED\n写 effect receipt",fillcolor="#f6efff"];
verified [label="VERIFIED / FINISHED\n检查业务后置条件",fillcolor="#eef9f1"];
reject [label="拒绝过期审批\n保持等待 · effect=0",fillcolor="#fdecea"];
received->proposed;
proposed->waiting;
waiting->check;
check->execute [label="是",color="#1e8449"];
check->reject [label="否",color="#b03a2e"];
execute->receipt;
receipt->verified;
reject->waiting [label="重新审批",style=dashed];
}
