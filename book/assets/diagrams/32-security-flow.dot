digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.15",nodesep="0.28",ranksep="0.42"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=16,color="#34495e",fillcolor="#f8fbfd"];
edge [fontname="Noto Sans CJK SC",fontsize=11,color="#5d6d7e"];
label [label="认证 principal + 标记 trust/provenance"];
project [label="最小 context\nsecret 不进入模型"];
intent [label="模型产生结构化 ToolIntent"];
authorize [shape=diamond,label="Capability + resource + args + approval?",fillcolor="#fff4e6"];
execute [label="隔离执行 + 短期凭据",fillcolor="#eef9f1"];
deny [label="CAPABILITY_DENIED\n零 effect",fillcolor="#fdecea"];
audit [label="记录 redacted decision / receipt"];
label->project;
project->intent;
intent->authorize;
authorize->execute [label="allow"];
authorize->deny [label="deny",color="#b03a2e"];
execute->audit;
deny->audit;
}
