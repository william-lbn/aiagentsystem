digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.15",nodesep="0.28",ranksep="0.42"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=16,color="#34495e",fillcolor="#f8fbfd"];
edge [fontname="Noto Sans CJK SC",fontsize=11,color="#5d6d7e"];
auth [label="认证 identity\ntenant 不来自 body"];
validate [label="验证 schema / size / rate / payload digest"];
create [shape=diamond,label="(tenant,key) 已存在?",fillcolor="#fff4e6"];
accept [label="202 + durable run\n相同 digest 返回原 run",fillcolor="#eef9f1"];
conflict [label="409 idempotency conflict",fillcolor="#fdecea"];
execute [label="异步 runtime + approval + effect + verifier"];
read [shape=diamond,label="Tenant-scoped object lookup"];
visible [label="200 resource / events / artifact"];
hidden [label="统一 404\n不泄漏 foreign object",fillcolor="#fdecea"];
auth->validate;
validate->create;
create->accept [label="absent / same"];
create->conflict [label="different payload",color="#b03a2e"];
accept->execute;
execute->read;
read->visible [label="owned"];
read->hidden [label="absent / foreign",color="#b03a2e"];
}
