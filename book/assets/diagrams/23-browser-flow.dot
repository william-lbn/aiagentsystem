digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.18",nodesep="0.28",ranksep="0.40"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=13,color="#34495e"];
edge [fontname="Noto Sans CJK SC",fontsize=9,color="#5d6d7e"];
observe [label="GET / Observe\nTargets + Revision r",fillcolor="#edf5ff"];
propose [label="生成 Typed Action\nTarget + Revision r",fillcolor="#fff4e6"];
ground [shape=diamond,label="Target 已观察且 r 仍当前?",fillcolor="#fdecea"];
act [label="POST / Execute Action",fillcolor="#f6efff"];
next [label="重新观察环境 r+1",fillcolor="#edf5ff"];
verify [shape=diamond,label="Postcondition 成立?",fillcolor="#fdecea"];
finish [label="FINISHED + Evidence",fillcolor="#eef9f1"];
stale [label="STALE / UNKNOWN\n零 Effect 或 Reconcile",fillcolor="#fdecea"];
observe->propose;
propose->ground;
ground->act [label="是"];
ground->stale [label="否"];
act->next;
next->verify;
verify->finish [label="是"];
verify->stale [label="否"];
stale->observe [label="重新观察",style=dashed];
}
