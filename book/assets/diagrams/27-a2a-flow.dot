digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.15",nodesep="0.25",ranksep="0.38"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=14,color="#34495e",fillcolor="#f8fbfd"];
edge [fontname="Noto Sans CJK SC",fontsize=10,color="#5d6d7e"];
discover [label="发现 Card\n校验 schema / version / interface"];
grant [label="签发 Delegation\n绑定 task / delegate / scope / expiry"];
gate [shape=diamond,label="授权与版本\n均有效？",fillcolor="#fff4e6"];
submit [label="事务写入 SUBMITTED\n固定 idempotency key"];
working [label="CAS → WORKING\n追加 durable event"];
complete [label="写 Artifact digest\nCAS → COMPLETED"];
recover [label="关闭并重开 Store\n轮询/订阅同一 Task"];
reject [label="拒绝\nTask=0 / Effect=0",fillcolor="#fdecea"];
verify [label="本地 Verifier\n闭合业务 postcondition",fillcolor="#eef9f1"];
discover->grant;
grant->gate;
gate->submit [label="yes"];
gate->reject [label="no",color="#b03a2e"];
submit->working;
working->complete;
complete->recover;
recover->verify;
}
