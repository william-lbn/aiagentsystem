digraph G {
graph [rankdir=LR,bgcolor="transparent",pad="0.15",nodesep="0.34",ranksep="0.52"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=15,color="#34495e",penwidth=1.2,fillcolor="#f8fbfd"];
edge [fontname="Noto Sans CJK SC",fontsize=10,color="#5d6d7e"];
runs [label="真实 runs\n成功 / 失败 / UNKNOWN",fillcolor="#fff4e6"];
verify [label="Outcome / effect\n独立 verifier"];
dataset [label="Trajectory registry\nprovenance + privacy",fillcolor="#edf5ff"];
split [label="Group / time / digest\n污染门禁",fillcolor="#f6efff"];
train [label="SFT / DPO / RFT\n候选模型"];
eval [label="隔离 holdout\nhard safety + cost"];
release [label="Model registry\ncanary / rollback",fillcolor="#eaf7ee"];
quarantine [label="QUARANTINED",fillcolor="#fdecea"];
runs->verify;
verify->dataset;
dataset->split;
split->train [label="eligible"];
split->quarantine [label="leak",color="#b03a2e"];
train->eval;
eval->release;
eval->dataset [label="失败回归\n不进入 holdout",style=dashed];
}
