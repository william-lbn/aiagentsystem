digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.15",nodesep="0.28",ranksep="0.42"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=16,color="#34495e",fillcolor="#f8fbfd"];
edge [fontname="Noto Sans CJK SC",fontsize=11,color="#5d6d7e"];
lock [label="锁定 task · image · harness · verifier · seed"];
preflight [label="预检环境 / gold artifact"];
execute [label="执行全部预注册 run\n保存 trajectory 与成本"];
score [label="独立 verifier + failure taxonomy"];
compare [shape=diamond,label="Manifest 可比较?",fillcolor="#fff4e6"];
publish [label="发布 score + interval + artifacts",fillcolor="#eef9f1"];
reject [label="拒绝聚合\n记录 mismatch / NOT_EXECUTED",fillcolor="#fdecea"];
lock->preflight;
preflight->execute;
execute->score;
score->compare;
compare->publish [label="yes"];
compare->reject [label="no",color="#b03a2e"];
}
