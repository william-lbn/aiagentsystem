digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.18",nodesep="0.3",ranksep="0.42"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=15,color="#34495e"];
edge [fontname="Noto Sans CJK SC",fontsize=10,color="#5d6d7e"];
candidate [label="Memory Candidate + Source",fillcolor="#fff4e6"];
policy [shape=diamond,label="允许写入?",fillcolor="#fdecea"];
append [label="Append Record\nValid/Recorded Time",fillcolor="#edf5ff"];
query [label="Tenant + Subject + Key + At"];
filter [label="范围/时间硬过滤",fillcolor="#fdecea"];
conflict [shape=diamond,label="最高等级冲突?",fillcolor="#fdecea"];
select [label="选择可追溯记录",fillcolor="#eef9f1"];
abstain [label="Conflict / 请求澄清",fillcolor="#fff4e6"];
candidate->policy;
policy->append [label="是"];
append->query;
query->filter;
filter->conflict;
conflict->select [label="否"];
conflict->abstain [label="是"];
}
