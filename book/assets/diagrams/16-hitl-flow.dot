digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.18",nodesep="0.3",ranksep="0.4"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=14,color="#34495e"];
edge [fontname="Noto Sans CJK SC",fontsize=10,color="#5d6d7e"];
proposal [label="规范化 Action\n计算 Args Digest",fillcolor="#fff4e6"];
pause [label="Checkpoint: WAITING_APPROVAL",fillcolor="#edf5ff"];
decision [label="认证主体作出决定",fillcolor="#f6efff"];
valid [shape=diamond,label="ID · Digest · State · Policy\nExpiry 全部匹配?",fillcolor="#fdecea"];
execute [label="执行一次 Effect",fillcolor="#eef9f1"];
journal [label="Journal + Verify",fillcolor="#edf5ff"];
stale [label="拒绝 / 过期 / 重新计划\n零 Effect",fillcolor="#fdecea"];
proposal->pause;
pause->decision;
decision->valid;
valid->execute [label="是"];
valid->stale [label="否"];
execute->journal;
}
