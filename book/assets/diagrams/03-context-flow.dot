digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.18",nodesep="0.25",ranksep="0.34"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=14,color="#34495e",fillcolor="#f8fbfd"];
edge [fontname="Noto Sans CJK SC",fontsize=10,color="#5d6d7e"];
candidate [label="读取候选记录"];
tenant [shape=diamond,label="tenant 匹配?",fillcolor="#fff4e6"];
trust [shape=diamond,label="不可信内容进入\n指令 channel?",fillcolor="#fff4e6"];
budget [shape=diamond,label="Mandatory ≤ Budget?",fillcolor="#fff4e6"];
rank [label="对合法 optional 记录\n按效用/成本稳定排序"];
assemble [label="输出 Context + Manifest",fillcolor="#eef9f1"];
quarantine1 [label="隔离：tenant_mismatch",fillcolor="#fdecea"];
quarantine2 [label="隔离：untrusted_instruction",fillcolor="#fdecea"];
infeasible [label="CONTEXT_INFEASIBLE\n不得静默丢 Policy",fillcolor="#fdecea"];
candidate->tenant;
tenant->trust [label="是"];
tenant->quarantine1 [label="否",color="#b03a2e"];
trust->budget [label="否"];
trust->quarantine2 [label="是",color="#b03a2e"];
budget->rank [label="是",color="#1e8449"];
budget->infeasible [label="否",color="#b03a2e"];
rank->assemble;
}
