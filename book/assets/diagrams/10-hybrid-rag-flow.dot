digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.18",nodesep="0.3",ranksep="0.42"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=15,color="#34495e"];
edge [fontname="Noto Sans CJK SC",fontsize=10,color="#5d6d7e"];
query [label="Query + Budget",fillcolor="#fff4e6"];
parallel [label="并行 Retriever Adapters",fillcolor="#edf5ff"];
validate [label="拒绝 Unknown / Duplicate / Forbidden ID",fillcolor="#fdecea"];
rrf [label="RRF 融合\n保留每路 Rank/Version",fillcolor="#eef9f1"];
enough [shape=diamond,label="证据充分?",fillcolor="#fdecea"];
answer [label="回答 + 引用 + Verifier",fillcolor="#f6efff"];
retry [label="Rewrite / Decompose\n预算单调递减",fillcolor="#fff4e6"];
query->parallel;
parallel->validate;
validate->rrf;
rrf->enough;
enough->answer [label="是"];
enough->retry [label="否"];
retry->parallel [label="仍有预算",style=dashed];
}
