digraph G {
graph [rankdir=LR,bgcolor="transparent",pad="0.18",nodesep="0.30",ranksep="0.55"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=12,color="#34495e"];
edge [fontname="Noto Sans CJK SC",fontsize=9,color="#5d6d7e"];
question [label="Question\nMetric · Time · Grain",fillcolor="#fff4e6"];
semantic [label="Semantic / Catalog Layer\nSchema · Policy · Data Version",fillcolor="#edf5ff"];
planner [label="SQL / Python Planner\nUntrusted Proposal",fillcolor="#fff4e6"];
gate [label="Execution Gate\nRBAC · Authorizer · Budget",fillcolor="#fdecea"];
db [label="Read-Only Data Snapshot",fillcolor="#eef9f1"];
artifact [label="Analysis Artifact\nSQL · Params · Plan · Rows · Digest",fillcolor="#f6efff"];
verify [label="Semantic / Numeric Verifier",fillcolor="#edf5ff"];
report [label="Claims + Uncertainty",fillcolor="#eef9f1"];
question->semantic;
semantic->planner;
planner->gate;
gate->db;
db->artifact;
artifact->verify;
verify->report;
}
