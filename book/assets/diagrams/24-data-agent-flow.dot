digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.18",nodesep="0.28",ranksep="0.40"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=13,color="#34495e"];
edge [fontname="Noto Sans CJK SC",fontsize=9,color="#5d6d7e"];
define [label="固定 Metric / Data Snapshot",fillcolor="#edf5ff"];
plan [label="生成参数化 Query",fillcolor="#fff4e6"];
authorize [shape=diamond,label="只读权限 + Schema + Budget 有效?",fillcolor="#fdecea"];
explain [label="EXPLAIN / Cost Gate",fillcolor="#f6efff"];
execute [label="Read-Only Execute\nRow / Time / Byte Limit",fillcolor="#eef9f1"];
artifact [label="保存 Plan / Result / Digest",fillcolor="#edf5ff"];
verify [shape=diamond,label="语义与数值复核通过?",fillcolor="#fdecea"];
report [label="报告 Observation / Uncertainty",fillcolor="#eef9f1"];
reject [label="拒绝或 NEEDS_INPUT",fillcolor="#fdecea"];
define->plan;
plan->authorize;
authorize->explain [label="是"];
authorize->reject [label="否"];
explain->execute;
execute->artifact;
artifact->verify;
verify->report [label="是"];
verify->reject [label="否"];
}
