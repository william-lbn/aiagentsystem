digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.15",nodesep="0.28",ranksep="0.42"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=16,color="#34495e",fillcolor="#f8fbfd"];
edge [fontname="Noto Sans CJK SC",fontsize=11,color="#5d6d7e"];
register [label="注册 task/version/digest"];
run [label="执行并持久化 trajectory/effect/cost"];
claim [label="Agent claim\n不产生成功权限"];
verify [label="独立读取环境与 ledger"];
checks [shape=diamond,label="全部 hard checks 通过?",fillcolor="#fff4e6"];
eligible [label="ELIGIBLE\n进入回归/发布",fillcolor="#eef9f1"];
quarantine [label="QUARANTINED\n保留失败证据",fillcolor="#fdecea"];
register->run;
run->claim;
claim->verify;
verify->checks;
checks->eligible [label="yes"];
checks->quarantine [label="no",color="#b03a2e"];
}
