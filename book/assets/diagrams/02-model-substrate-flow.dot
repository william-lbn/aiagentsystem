digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.18",nodesep="0.26",ranksep="0.36"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=14,color="#34495e",fillcolor="#f8fbfd"];
edge [fontname="Noto Sans CJK SC",fontsize=10,color="#5d6d7e"];
payload [label="候选 Tool Decision"];
parse [shape=diamond,label="JSON 可解析?",fillcolor="#fff4e6"];
typed [shape=diamond,label="Schema 精确匹配?",fillcolor="#fff4e6"];
available [shape=diamond,label="Tool 可用且策略允许?",fillcolor="#fff4e6"];
accept [label="接受为 Intent\n随后再授权执行",fillcolor="#eef9f1"];
syntaxerr [label="syntax reason code\n零调度",fillcolor="#fdecea"];
typeerr [label="schema reason code\n例：string ≠ int",fillcolor="#fdecea"];
semanticerr [label="semantic reason code\n零调度",fillcolor="#fdecea"];
payload->parse;
parse->typed [label="是"];
parse->syntaxerr [label="否",color="#b03a2e"];
typed->available [label="是"];
typed->typeerr [label="否",color="#b03a2e"];
available->accept [label="是",color="#1e8449"];
available->semanticerr [label="否",color="#b03a2e"];
}
