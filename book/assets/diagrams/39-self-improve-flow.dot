digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.15",nodesep="0.27",ranksep="0.40"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=15,color="#34495e",fillcolor="#f8fbfd"];
edge [fontname="Noto Sans CJK SC",fontsize=10,color="#5d6d7e"];
freeze [label="冻结 baseline / eval manifest"];
generate [label="隔离生成 candidate artifact"];
offline [shape=diamond,label="配对质量提升 +\n安全/成本 hard gates?",fillcolor="#fff4e6"];
reject [label="REJECTED\n保留失败 candidate",fillcolor="#fdecea"];
canary [label="CANARY\nbaseline 仍可寻址"];
online [shape=diamond,label="独立 verifier 与 SLO\n持续通过?",fillcolor="#fff4e6"];
promote [label="PROMOTED\n原子切 active pointer",fillcolor="#eaf7ee"];
rollback [label="ROLLED_BACK\n冻结扩容",fillcolor="#fdecea"];
freeze->generate;
generate->offline;
offline->reject [label="no",color="#b03a2e"];
offline->canary [label="yes"];
canary->online;
online->promote [label="yes"];
online->rollback [label="no",color="#b03a2e"];
}
