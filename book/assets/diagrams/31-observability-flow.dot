digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.15",nodesep="0.28",ranksep="0.42"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=16,color="#34495e",fillcolor="#f8fbfd"];
edge [fontname="Noto Sans CJK SC",fontsize=11,color="#5d6d7e"];
context [label="传播 tenant/run/trace context"];
record [label="记录 intent · result · state · effect"];
redact [label="结构化脱敏后 canonical serialize"];
persist [label="追加 seq + prev_hash + row_hash"];
verify [shape=diamond,label="Parent / sequence / hash 有效?",fillcolor="#fff4e6"];
export [label="导出 trajectory / metrics / audit",fillcolor="#eef9f1"];
isolate [label="隔离损坏证据\n禁止导出",fillcolor="#fdecea"];
context->record;
record->redact;
redact->persist;
persist->verify;
verify->export [label="yes"];
verify->isolate [label="no",color="#b03a2e"];
}
