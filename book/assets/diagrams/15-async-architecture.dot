digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.18",nodesep="0.34",ranksep="0.48"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=14,color="#34495e"];
edge [fontname="Noto Sans CJK SC",fontsize=10,color="#5d6d7e"];
parent [label="Run Supervisor\nDeadline · Cancellation · Task Table",fillcolor="#fdecea"];
queue [label="Bounded Queue / Semaphore\nBackpressure",fillcolor="#edf5ff"];
tasks [label="Child Tasks\nQUEUED → RUNNING → Terminal",fillcolor="#fff4e6"];
remote [label="Tools / Remote Services\nEffect 状态独立",fillcolor="#eef9f1"];
stream [label="Typed Event Stream\nSequence · Provenance",fillcolor="#f6efff"];
reconcile [label="UNKNOWN Reconciliation",fillcolor="#fdecea"];
parent->queue;
queue->tasks;
tasks->remote;
tasks->stream;
remote->stream;
remote->reconcile [label="取消后仍可能提交"];
stream->parent [label="完成证据"];
reconcile->parent [label="权威结果"];
}
