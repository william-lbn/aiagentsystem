sources [label="用户确认 / 权威事件 / 模型提议",fillcolor="#fff4e6"];
write [label="Memory Write Policy\nConsent · Sensitivity · Authority",fillcolor="#fdecea"];
store [label="双时态 Record Store\nValid Time · Recorded Time\nSource · Supersedes",fillcolor="#edf5ff"];
index [label="派生索引\nKeyword · Vector · Graph",fillcolor="#eef9f1"];
resolve [label="Scope/Time Filter + Conflict Resolver",fillcolor="#fdecea"];
