digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.15",nodesep="0.27",ranksep="0.40"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=15,color="#34495e",fillcolor="#f8fbfd"];
edge [fontname="Noto Sans CJK SC",fontsize=10,color="#5d6d7e"];
freeze [label="冻结 source / lock / builder"];
build [label="分平台构建 + digest\nSBOM + provenance"];
gate [shape=diamond,label="preflight 与签名\n全部通过?",fillcolor="#fff4e6"];
blocked [label="BLOCKED\n保留失败证据",fillcolor="#fdecea"];
canary [label="Canary：外部 API / restart\ncheckpoint / effect smoke"];
healthy [shape=diamond,label="语义 health 与 SLO\n仍满足?",fillcolor="#fff4e6"];
promote [label="PROMOTED\n扩大流量",fillcolor="#eaf7ee"];
rollback [label="ROLLBACK + drain\nUNKNOWN effect 另行协调",fillcolor="#fdecea"];
freeze->build;
build->gate;
gate->blocked [label="no",color="#b03a2e"];
gate->canary [label="yes"];
canary->healthy;
healthy->promote [label="yes"];
healthy->rollback [label="no",color="#b03a2e"];
}
