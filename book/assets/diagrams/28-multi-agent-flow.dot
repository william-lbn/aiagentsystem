digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.15",nodesep="0.24",ranksep="0.36"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=14,color="#34495e",fillcolor="#f8fbfd"];
edge [fontname="Noto Sans CJK SC",fontsize=10,color="#5d6d7e"];
compile [label="编译 Work-order DAG\n固定 owner / scope / cost / inputs"];
frontier [label="计算 READY frontier\nresearch ∥ patch"];
claim [shape=diamond,label="owner + scope + deps\n+ budget 均满足？",fillcolor="#fff4e6"];
reserve [label="原子 claim 与预算预留"];
complete [label="Worker 提交\nartifact digest"];
join [label="verify 解锁\n检查 exact task set"];
effect [label="发布 Effect\n(run_id,effect_key) 唯一",fillcolor="#eef9f1"];
reject [label="Rollback\n预算=0 / Effect=0",fillcolor="#fdecea"];
reopen [label="关闭并重开\n恢复 COMPLETED + receipt"];
compile->frontier;
frontier->claim;
claim->reserve [label="yes"];
claim->reject [label="no",color="#b03a2e"];
reserve->complete;
complete->join;
join->effect;
effect->reopen;
}
