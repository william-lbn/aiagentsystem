digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.18",nodesep="0.32",ranksep="0.44"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=15,color="#34495e"];
edge [fontname="Noto Sans CJK SC",fontsize=10,color="#5d6d7e"];
load [label="加载锁定版本合同",fillcolor="#fff4e6"];
validate [label="名称/描述/Schema\nCapability/Risk/Effect"];
valid [shape=diamond,label="合同有效?",fillcolor="#fdecea"];
intent [label="固化 Action Intent\nArgs Digest + Contract Version",fillcolor="#edf5ff"];
execute [label="最小权限执行",fillcolor="#eef9f1"];
shape [label="结果塑形\n小结果 Inline / 大结果 Artifact"];
verify [label="Verifier + Trace",fillcolor="#f6efff"];
reject [label="Reason Codes\nEffect Count = 0",fillcolor="#fdecea"];
load->validate;
validate->valid;
valid->intent [label="是"];
valid->reject [label="否",color="#b03a2e"];
intent->execute;
execute->shape;
shape->verify;
}
