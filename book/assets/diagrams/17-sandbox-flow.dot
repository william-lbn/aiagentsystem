digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.18",nodesep="0.3",ranksep="0.4"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=14,color="#34495e"];
edge [fontname="Noto Sans CJK SC",fontsize=10,color="#5d6d7e"];
request [label="File / Command / Network Request",fillcolor="#fff4e6"];
cap [shape=diamond,label="持有最小 Capability?",fillcolor="#fdecea"];
resolve [label="Canonicalize / Resolve\n绑定 Workspace Root",fillcolor="#edf5ff"];
inside [shape=diamond,label="对象仍在授权边界?",fillcolor="#fdecea"];
execute [label="受 OS 配额与隔离执行",fillcolor="#eef9f1"];
receipt [label="Exit · Resource · Diff · Digest",fillcolor="#f6efff"];
deny [label="Fail Closed + Audit",fillcolor="#fdecea"];
request->cap;
cap->resolve [label="是"];
cap->deny [label="否"];
resolve->inside;
inside->execute [label="是"];
inside->deny [label="否"];
execute->receipt;
}
