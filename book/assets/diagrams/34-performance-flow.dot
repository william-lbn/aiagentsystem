digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.15",nodesep="0.28",ranksep="0.42"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=16,color="#34495e",fillcolor="#f8fbfd"];
edge [fontname="Noto Sans CJK SC",fontsize=11,color="#5d6d7e"];
define [label="固定 workload · host · budget · verifier"];
measure [label="实测 queue / stage / total / cost"];
repeat [label="重复运行\n分位数 + failure taxonomy"];
gate [shape=diamond,label="全部 stage / total / quality SLO?",fillcolor="#fff4e6"];
release [label="允许发布\n保存 samples + manifest",fillcolor="#eef9f1"];
block [label="阻断发布\n定位瓶颈并回归",fillcolor="#fdecea"];
define->measure;
measure->repeat;
repeat->gate;
gate->release [label="yes"];
gate->block [label="no",color="#b03a2e"];
}
