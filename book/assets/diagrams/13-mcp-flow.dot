digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.18",nodesep="0.3",ranksep="0.42"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=15,color="#34495e"];
edge [fontname="Noto Sans CJK SC",fontsize=10,color="#5d6d7e"];
request [label="JSON-RPC + Per-Request Meta\nVersion · Capabilities",fillcolor="#fff4e6"];
headers [label="Streamable HTTP Routing\nVersion · Method · Name",fillcolor="#edf5ff"];
valid [shape=diamond,label="Header/Body 一致?",fillcolor="#fdecea"];
handler [label="Server Handler / Tool",fillcolor="#eef9f1"];
input [shape=diamond,label="需要中途输入?",fillcolor="#fdecea"];
mrtr [label="input_required\nOpaque requestState"];
resume [label="Host 收集 Input\n原状态重发"];
complete [label="Complete / Task / Artifact",fillcolor="#f6efff"];
reject [label="Protocol Reject\n不得进入 Handler",fillcolor="#fdecea"];
request->headers;
headers->valid;
valid->handler [label="是"];
valid->reject [label="否",color="#b03a2e"];
handler->input;
input->complete [label="否"];
input->mrtr [label="是"];
mrtr->resume [label="采集 Input",style=dashed];
resume->handler [label="校验 State/轮数",style=dashed];
}
