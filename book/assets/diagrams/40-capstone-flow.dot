digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.15",nodesep="0.25",ranksep="0.38"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=14,color="#34495e",fillcolor="#f8fbfd"];
edge [fontname="Noto Sans CJK SC",fontsize=9,color="#5d6d7e"];
r [label="RECEIVED：tenant + task digest"];
t [label="TRIAGED：risk + trust"];
p [label="PLANNED：capability-checked intent"];
a [label="WAITING_APPROVAL：bind intent digest"];
e [label="EXECUTING：prewrite effect key"];
ack [shape=diamond,label="收到 durable receipt?",fillcolor="#fff4e6"];
u [label="UNKNOWN",fillcolor="#fdecea"];
rec [label="RECONCILING\nprovider lookup"];
v [label="VERIFYING\nauthority + effect + trace"];
ok [shape=diamond,label="hard checks 全部闭合?",fillcolor="#fff4e6"];
done [label="COMPLETED",fillcolor="#eaf7ee"];
q [label="QUARANTINED / 人工处置",fillcolor="#fdecea"];
r->t;
t->p;
p->a;
a->e;
e->ack;
ack->v [label="yes"];
ack->u [label="no",color="#b03a2e"];
u->rec;
rec->v;
v->ok;
ok->done [label="yes"];
ok->q [label="no",color="#b03a2e"];
}
