goal [label="目标 / 环境观察",fillcolor="#fff4e6"];
model [label="决策面\n模型 · Context · Planner",fillcolor="#edf5ff"];
intent [label="候选 Intent\n不是副作用",fillcolor="#edf5ff"];
govern [label="治理面\n身份 · 策略 · 审批 · 预算",fillcolor="#fdecea"];
runtime [label="执行面\nRuntime · Tool · Sandbox",fillcolor="#eef9f1"];
