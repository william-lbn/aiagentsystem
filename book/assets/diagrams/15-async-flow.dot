digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.18",nodesep="0.3",ranksep="0.4"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=14,color="#34495e"];
edge [fontname="Noto Sans CJK SC",fontsize=10,color="#5d6d7e"];
spawn [label="创建 Task → QUEUED",fillcolor="#edf5ff"];
capacity [shape=diamond,label="取得并发容量?",fillcolor="#fdecea"];
run [label="RUNNING\n真实 Coroutine / Tool",fillcolor="#fff4e6"];
result [shape=diamond,label="满足业务 Oracle?",fillcolor="#fdecea"];
cancel [label="取消 Losers",fillcolor="#fdecea"];
await [label="Await 清理并记录终态",fillcolor="#f6efff"];
all [shape=diamond,label="所有 Task 已终止?",fillcolor="#fdecea"];
done [label="父 Scope 完成",fillcolor="#eef9f1"];
spawn->capacity;
capacity->run [label="是"];
capacity->capacity [label="等待",style=dashed];
run->result;
result->cancel [label="first-success"];
result->await [label="失败/普通完成"];
cancel->await;
await->all;
all->done [label="是"];
all->await [label="否"];
}
