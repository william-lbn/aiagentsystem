digraph G {
graph [rankdir=LR,bgcolor="transparent",pad="0.15",nodesep="0.34",ranksep="0.52"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=15,color="#34495e",penwidth=1.2,fillcolor="#f8fbfd"];
edge [fontname="Noto Sans CJK SC",fontsize=10,color="#5d6d7e"];
source [label="Source revision\nlock + policy",fillcolor="#fff4e6"];
builder [label="Locked builder\nSBOM + provenance",fillcolor="#edf5ff"];
index [label="OCI image index",fillcolor="#eef9f1"];
amd [label="linux/amd64\nmanifest digest"];
arm [label="linux/arm64\nmanifest digest"];
runtime [label="Runtime config\nUID / port / volume",fillcolor="#f6efff"];
state [label="Checkpoint / lease\neffect identity"];
verify [label="External health\ncanary + verifier",fillcolor="#eaf7ee"];
source->builder;
builder->index;
index->amd;
index->arm;
amd->runtime;
arm->runtime;
runtime->state;
state->verify;
builder->verify [label="attestation",style=dashed];
}
