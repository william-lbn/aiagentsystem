digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.18",nodesep="0.3",ranksep="0.42"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=15,color="#34495e"];
edge [fontname="Noto Sans CJK SC",fontsize=10,color="#5d6d7e"];
prepare [label="PREPARED\n先持久化 Intent",fillcolor="#fff4e6"];
call [label="以稳定 Key 调用远端",fillcolor="#edf5ff"];
reply [shape=diamond,label="收到可信 Receipt?",fillcolor="#fdecea"];
commit [label="COMMITTED\n保存 Receipt",fillcolor="#eef9f1"];
unknown [label="UNKNOWN\n禁止假定失败",fillcolor="#fdecea"];
lookup [label="查询远端权威 Ledger"];
found [shape=diamond,label="效果存在?",fillcolor="#fdecea"];
notapplied [label="NOT_APPLIED\n允许安全重试",fillcolor="#fff4e6"];
prepare->call;
call->reply;
reply->commit [label="是"];
reply->unknown [label="否"];
unknown->lookup;
lookup->found;
found->commit [label="是"];
found->notapplied [label="否"];
}
