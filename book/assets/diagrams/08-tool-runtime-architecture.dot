digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.18",nodesep="0.34",ranksep="0.48"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=15,color="#34495e",penwidth=1.2];
edge [fontname="Noto Sans CJK SC",fontsize=10,color="#5d6d7e"];
intent [label="Canonical Action Intent\nAction ID · Args Hash · Idempotency Key",fillcolor="#edf5ff"];
journal [label="Durable Effect Journal\nPREPARED / UNKNOWN / COMMITTED",fillcolor="#fff4e6"];
remote [label="外部系统\nIdempotency Ledger",fillcolor="#eef9f1"];
reconcile [label="Reconciliation Worker\n查询而非盲重试",fillcolor="#fdecea"];
verify [label="业务 Verifier\n后置条件与 Receipt",fillcolor="#f6efff"];
intent->journal [label="persist PREPARED"];
journal->remote [label="authorized call"];
remote->journal [label="reply or timeout"];
journal->reconcile [label="UNKNOWN"];
reconcile->remote [label="lookup"];
reconcile->journal [label="COMMITTED / NOT_APPLIED"];
journal->verify;
}
