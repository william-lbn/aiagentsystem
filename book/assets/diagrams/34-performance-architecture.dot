digraph G {
graph [rankdir=LR,bgcolor="transparent",pad="0.15",nodesep="0.4",ranksep="0.55"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=17,color="#34495e",penwidth=1.2];
edge [fontname="Noto Sans CJK SC",fontsize=11,color="#5d6d7e"];
workload [label="Workload\ntasks · arrival · concurrency",fillcolor="#fff4e6"];
queue [label="Queue / admission\nrate · budget · backpressure",fillcolor="#edf5ff"];
critical [label="Critical path\ncontext · model · tool · persist",fillcolor="#eef9f1"];
cache [label="Cache / router\ntenant · policy · version",fillcolor="#f6efff"];
verifier [label="Verified success\nquality · safety · effect",fillcolor="#edf5ff"];
report [label="p50/p95/p99 + cost\nrelease SLO gate",fillcolor="#f7f9f9"];
workload->queue;
queue->critical;
cache->critical;
critical->verifier;
verifier->report;
workload->report [label="manifest"];
}
