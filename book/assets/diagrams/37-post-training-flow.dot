digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.15",nodesep="0.27",ranksep="0.40"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=15,color="#34495e",fillcolor="#f8fbfd"];
edge [fontname="Noto Sans CJK SC",fontsize=10,color="#5d6d7e"];
target [label="定义可证伪 capability target"];
collect [label="采集完整 trajectory\nlineage + effect + cost"];
split [shape=diamond,label="task group / transcript\ntrain-eval 隔离?",fillcolor="#fff4e6"];
quarantine [label="数据集 QUARANTINED",fillcolor="#fdecea"];
opt [label="训练不可变 candidate\n保存配置与 artifact"];
eval [shape=diamond,label="独立 eval\n质量、安全、成本通过?",fillcolor="#fff4e6"];
canary [label="Shadow / canary"];
release [label="PROMOTE 或 ROLLBACK",fillcolor="#eaf7ee"];
target->collect;
collect->split;
split->quarantine [label="no",color="#b03a2e"];
split->opt [label="yes"];
opt->eval;
eval->quarantine [label="no",color="#b03a2e"];
eval->canary [label="yes"];
canary->release;
}
