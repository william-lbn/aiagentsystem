digraph G {
graph [rankdir=LR,bgcolor="transparent",pad="0.18",nodesep="0.30",ranksep="0.55"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=12,color="#34495e"];
edge [fontname="Noto Sans CJK SC",fontsize=9,color="#5d6d7e"];
question [label="Research Question\nEntity · Cutoff · Evidence Standard",fillcolor="#fff4e6"];
retrieval [label="Retriever / Browser\nPrimary + Counter Evidence",fillcolor="#edf5ff"];
source [label="Source Artifact\nURI · Time · Content Digest",fillcolor="#f6efff"];
claim [label="Atomic Claims",fillcolor="#fff4e6"];
binder [label="Evidence Binder\nExact Span · Quote · Version",fillcolor="#fdecea"];
conflict [label="Conflict / Temporal Graph",fillcolor="#edf5ff"];
report [label="Synthesis\nObservation · Inference · Unknown",fillcolor="#eef9f1"];
audit [label="Coverage / Entailment / Staleness Audit",fillcolor="#f6efff"];
question->retrieval;
retrieval->source;
source->claim;
claim->binder;
binder->conflict;
conflict->report;
report->audit;
}
