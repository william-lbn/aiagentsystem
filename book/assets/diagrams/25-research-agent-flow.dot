digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.18",nodesep="0.28",ranksep="0.40"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=13,color="#34495e"];
edge [fontname="Noto Sans CJK SC",fontsize=9,color="#5d6d7e"];
decompose [label="分解 Atomic Research Questions",fillcolor="#edf5ff"];
retrieve [label="检索 Primary / Conflicting Sources",fillcolor="#fff4e6"];
freeze [label="保存 Retrieved Time + Content Digest",fillcolor="#f6efff"];
bind [label="Claim 绑定 Exact Span / Page",fillcolor="#edf5ff"];
valid [shape=diamond,label="Digest / Quote / Time / Entailment 有效?",fillcolor="#fdecea"];
synth [label="综合并标注 Inference / Uncertainty",fillcolor="#eef9f1"];
unknown [label="Unsupported / Conflict / UNKNOWN",fillcolor="#fdecea"];
audit [label="Claim-Level Citation Audit",fillcolor="#f6efff"];
decompose->retrieve;
retrieve->freeze;
freeze->bind;
bind->valid;
valid->synth [label="是"];
valid->unknown [label="否"];
synth->audit;
unknown->audit;
}
