digraph G {
graph [rankdir=LR,bgcolor="transparent",pad="0.18",nodesep="0.34",ranksep="0.5"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=14,color="#34495e"];
edge [fontname="Noto Sans CJK SC",fontsize=10,color="#5d6d7e"];
runtime [label="Durable Runtime\nState Version · Code/Policy Pin",fillcolor="#fdecea"];
checkpoint [label="Checkpoint Snapshot\n快速 Resume + CAS",fillcolor="#edf5ff"];
journal [label="Event / Effect Journal\nIntent · Receipt · Hash Chain",fillcolor="#f6efff"];
worker [label="Leased Worker\nFencing Token",fillcolor="#fff4e6"];
external [label="External System\nIdempotency · Query",fillcolor="#eef9f1"];
reconcile [label="UNKNOWN Reconciler",fillcolor="#fdecea"];
runtime->checkpoint [label="atomic versioned save"];
runtime->journal [label="append transition"];
checkpoint->worker [label="resume"];
journal->worker [label="replay evidence"];
worker->external [label="action identity"];
external->journal [label="receipt"];
external->reconcile [label="ambiguous outcome"];
reconcile->journal [label="authoritative result"];
}
