digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.18",nodesep="0.28",ranksep="0.40"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=13,color="#34495e"];
edge [fontname="Noto Sans CJK SC",fontsize=9,color="#5d6d7e"];
auth [label="认证 Principal / Tenant",fillcolor="#edf5ff"];
bind [label="读取 Conversation→Workspace Binding",fillcolor="#edf5ff"];
valid [shape=diamond,label="Binding + Expected Sequence 有效?",fillcolor="#fdecea"];
commit [label="事务提交 Durable Event",fillcolor="#f6efff"];
dispatch [label="派发到 Scoped Worker",fillcolor="#fff4e6"];
effect [label="执行并写 Receipt / Artifact Digest",fillcolor="#eef9f1"];
publish [label="按 Sequence 发布\nCursor 可重连回放",fillcolor="#edf5ff"];
reject [label="Fail Closed\n无跨 Workspace Event",fillcolor="#fdecea"];
auth->bind;
bind->valid;
valid->commit [label="是"];
valid->reject [label="否"];
commit->dispatch;
dispatch->effect;
effect->publish;
}
