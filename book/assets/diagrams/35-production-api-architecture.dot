digraph G {
graph [rankdir=LR,bgcolor="transparent",pad="0.15",nodesep="0.4",ranksep="0.55"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=17,color="#34495e",penwidth=1.2];
edge [fontname="Noto Sans CJK SC",fontsize=11,color="#5d6d7e"];
client [label="Client\nrequest + idempotency key",fillcolor="#fff4e6"];
gateway [label="API boundary\nTLS · AuthN · schema · rate",fillcolor="#edf5ff"];
store [label="Tenant-scoped task store\nunique(tenant,key)",fillcolor="#eef9f1"];
runtime [label="Durable Runtime\npolicy · budget · checkpoint",fillcolor="#edf5ff"];
governance [label="Approval · Effect · Verifier",fillcolor="#f6efff"];
evidence [label="Artifact · Event · Audit\ntenant ACL",fillcolor="#f7f9f9"];
client->gateway;
gateway->store;
store->runtime;
runtime->governance;
governance->evidence;
evidence->gateway [label="GET / stream",style=dashed];
}
