digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.18",nodesep="0.3",ranksep="0.4"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=14,color="#34495e"];
edge [fontname="Noto Sans CJK SC",fontsize=10,color="#5d6d7e"];
discover [label="读取 Manifest / Artifact Digest",fillcolor="#edf5ff"];
validate [shape=diamond,label="Identity · Dependency · Capability\n兼容性有效?",fillcolor="#fdecea"];
order [label="稳定拓扑排序",fillcolor="#fff4e6"];
activate [label="按序 Activate 并保存 Handle",fillcolor="#eef9f1"];
success [shape=diamond,label="全部激活成功?",fillcolor="#fdecea"];
ready [label="发布 Runtime READY",fillcolor="#eef9f1"];
rollback [label="逆序 Dispose 已激活 Handle",fillcolor="#fdecea"];
invalid [label="INVALID / Fail Closed",fillcolor="#fdecea"];
discover->validate;
validate->order [label="是"];
validate->invalid [label="否"];
order->activate;
activate->success;
success->ready [label="是"];
success->rollback [label="否"];
rollback->invalid [label="记录 cleanup evidence"];
}
