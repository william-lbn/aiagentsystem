digraph G {
graph [rankdir=TB,bgcolor="transparent",pad="0.18",nodesep="0.25",ranksep="0.35"];
node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=14,color="#34495e",fillcolor="#f8fbfd"];
edge [fontname="Noto Sans CJK SC",fontsize=10,color="#5d6d7e"];
append [label="收到 ToolResult"];
known [shape=diamond,label="call_id 属于 Pending?",fillcolor="#fff4e6"];
same [shape=diamond,label="tool name 匹配?",fillcolor="#fff4e6"];
commit [label="原子追加结果\nPending → Completed",fillcolor="#eef9f1"];
finalgate [shape=diamond,label="Pending = ∅?",fillcolor="#fff4e6"];
final [label="接受最终响应",fillcolor="#eef9f1"];
orphan [label="拒绝 orphan/duplicate\nLedger 不变",fillcolor="#fdecea"];
mismatch [label="拒绝 name mismatch\nLedger 不变",fillcolor="#fdecea"];
wait [label="继续等待或显式取消",fillcolor="#fff4e6"];
append->known;
known->same [label="是"];
known->orphan [label="否",color="#b03a2e"];
same->commit [label="是"];
same->mismatch [label="否",color="#b03a2e"];
commit->finalgate;
finalgate->final [label="是",color="#1e8449"];
finalgate->wait [label="否"];
}
